POSTGRES_DB=salesops
POSTGRES_USER=salesops
POSTGRES_PASSWORD=salesops

APP_ALLOWED_ORIGIN=http://localhost:18080
SPRING_FLYWAY_ENABLED=false

BACKEND_IMAGE=europe-west1-docker.pkg.dev/salesops-crm-pilot/salesops-docker/salesops-backend:rollback-previous
FRONTEND_IMAGE=europe-west1-docker.pkg.dev/salesops-crm-pilot/salesops-docker/salesops-frontend:rollback-previous
NGINX_CONFIG_FILE=./nginx/proxy-http.conf
NGINX_HTTP_PORT=18080
NGINX_HTTPS_PORT=18443
